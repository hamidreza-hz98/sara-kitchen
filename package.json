{
  "name": "sara-kitchen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "security:audit": "pnpm audit --prod --audit-level critical",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:locales && pnpm test:boundaries && pnpm check:boundaries && pnpm test:api-contract && pnpm test:quality && pnpm test:hooks && pnpm test:scripts && pnpm test:infra && pnpm test:adr && pnpm test:dod",
    "test:unit": "vitest run --config vitest.config.mts",
    "unit": "pnpm test:unit",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "integration": "pnpm test:integration",
    "check:locales": "node scripts/check-locale-messages.mjs",
    "test:locales": "node --test scripts/check-locale-messages.test.mjs && pnpm check:locales",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e": "pnpm test:e2e",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "test:boundaries": "node --test scripts/check-module-boundaries.test.mjs",
    "check:api-contract": "node scripts/check-route-handler-contract.mjs",
    "test:api-contract": "node --test scripts/check-route-handler-contract.test.mjs && pnpm check:api-contract",
    "test:quality": "node --test scripts/check-quality-rules.test.mjs",
    "test:hooks": "node --test scripts/check-git-hooks.test.mjs",
    "test:scripts": "node --test scripts/check-common-scripts.test.mjs",
    "test:infra": "node --test scripts/check-local-infrastructure.test.mjs",
    "test:adr": "node --test scripts/check-architecture-decisions.test.mjs",
    "test:dod": "node --test scripts/check-definition-of-done.test.mjs",
    "infra:up": "node scripts/local-infrastructure.mjs up",
    "infra:down": "node scripts/local-infrastructure.mjs down",
    "infra:status": "node scripts/local-infrastructure.mjs status",
    "infra:logs": "node scripts/local-infrastructure.mjs logs",
    "infra:config": "node scripts/local-infrastructure.mjs config",
    "db:seed": "node scripts/run-database-operation.mjs seed",
    "seed": "pnpm db:seed",
    "db:migrate": "node scripts/run-database-operation.mjs migrate",
    "migrate": "pnpm db:migrate",
    "db:indexes": "node scripts/run-database-operation.mjs indexes",
    "indexes": "pnpm db:indexes",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
