# Public values are inlined into browser bundles during `next build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Core server infrastructure.
MONGODB_URI=mongodb://127.0.0.1:27017/sara-kitchen
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_PASSWORD_RESET_SECRET=replace-with-a-different-32-character-secret

# Operational logging. Deployment version falls back to Vercel's system commit/deployment ID.
LOG_LEVEL=debug
DEPLOYMENT_VERSION=local

# Sentry error/performance monitoring. Keep disabled until a project and alert workflow exist.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SOURCE_MAPS_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Customer password-reset SMS; disabled until real Twilio credentials are supplied.
RESET_SMS_ENABLED=false
TWILIO_RESET_ACCOUNT_SID=
TWILIO_RESET_AUTH_TOKEN=
TWILIO_RESET_FROM_NUMBER=

# MinIO / S3-compatible media storage. The endpoint must not include a protocol.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=sara-kitchen-media
MINIO_REGION=us-east-1

# Porto kitchen origin used by delivery-distance calculations.
KITCHEN_LATITUDE=replace-with-kitchen-latitude
KITCHEN_LONGITUDE=replace-with-kitchen-longitude

# MB Way sandbox. Credentials are required only when enabled.
MBWAY_ENABLED=false
MBWAY_API_URL=
MBWAY_MERCHANT_ID=
MBWAY_API_KEY=
MBWAY_WEBHOOK_SECRET=

# Employer WhatsApp order notifications. Values are required only when enabled.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_EMPLOYER_NUMBER=
